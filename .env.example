# Free key from https://console.groq.com/keys  (required for the AI teacher)
GROQ_API_KEY=

# Optional: change the model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: only these Google accounts may use the AI teacher (comma-separated).
# Leave empty to allow any signed-in Google account.
# TUTOR_ALLOWED_EMAILS=you@gmail.com
